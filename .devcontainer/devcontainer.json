{
    "name": "Onsite Print Checkin - React",
    "build": {
        "dockerfile": "Dockerfile"
    },
    "remoteUser": "node",
    "containerUser": "node",
    "updateRemoteUserUID": true,
    "mounts": [
        "source=${localEnv:HOME}/.copilot/session-state,target=/home/node/.copilot/session-state,type=bind"
    ],
    "runArgs": ["--add-host=host.docker.internal:host-gateway"],
    "remoteEnv": {
        "API_PROXY_TARGET": "http://host.docker.internal:8080"
    },
    "forwardPorts": [
        5173
    ],
    "portsAttributes": {
        "5173": {
            "label": "React development server",
            "onAutoForward": "notify"
        }
    },
    "postCreateCommand": "npm ci",
    "customizations": {
        "vscode": {
            "extensions": [
                "dbaeumer.vscode-eslint"
            ],
            "settings": {
                "editor.tabSize": 2
            }
        }
    }
}